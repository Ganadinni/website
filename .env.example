# ─── Shopify Storefront API ──────────────────────────────────────────────────
# Get from: Shopify Admin → Apps → Develop apps → Create app → Storefront API
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token"

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# WhatsApp Business number (with country code, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# ─── Contact / Lead Capture ───────────────────────────────────────────────────
# Endpoint to POST enquiry form data (optional — can use Formspree, etc.)
ENQUIRY_WEBHOOK_URL=""

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.theteaplanet.com"
